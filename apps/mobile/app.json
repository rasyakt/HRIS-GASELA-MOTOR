{
  "expo": {
    "name": "Gasela HRIS",
    "slug": "gasela-hris",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "gaselahris",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lokasi digunakan untuk validasi check-in/check-out kantor",
        "NSCameraUsageDescription": "Kamera digunakan untuk foto check-in/check-out",
        "NSFaceIDUsageDescription": "Face ID digunakan untuk verifikasi identitas saat melakukan presensi check-in dan check-out."
      }
    },
    "android": {
      "package": "com.gasela.hris",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Izinkan Gasela HRIS menggunakan Face ID untuk verifikasi kehadiran."
        }
      ]
    ]
  }
}
