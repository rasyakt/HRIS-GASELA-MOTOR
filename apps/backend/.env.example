# Database
DATABASE_URL="mysql://root:@localhost:3306/gasela_hris"

# Auth
JWT_SECRET=dev-secret-change-me-32-characters
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Server
PORT=3001
NODE_ENV=development

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# FCM (isi saat modul notification dikerjakan)
FCM_SERVER_KEY=

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:3000
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
