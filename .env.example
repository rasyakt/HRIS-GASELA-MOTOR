# ===== Root .env.example (template — salin ke .env lalu isi nilai sebenarnya) =====

# --- Database (MySQL) ---
# Untuk development (Laragon lokal):
DATABASE_URL="mysql://root:@localhost:3306/gasela_hris"
# Untuk production (1.000+ user) — tambahkan connection pool params:
# DATABASE_URL="mysql://root:PASSWORD@localhost:3306/gasela_hris?connection_limit=20&pool_timeout=30&connect_timeout=10"
# Penjelasan:
#   connection_limit=20  → maksimum 20 koneksi DB concurrent per instance PM2
#   pool_timeout=30      → tunggu 30 detik jika semua koneksi sibuk sebelum error
#   connect_timeout=10   → timeout buka koneksi baru 10 detik


# --- Backend auth ---
JWT_SECRET=change-me-32-char-min
JWT_REFRESH_SECRET=change-me-another-32-char
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Mobile push ---
FCM_SERVER_KEY=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Mobile API ---
EXPO_PUBLIC_API_URL=http://192.168.1.10:3001

# --- Production (docker-compose.prod.yml) ---
# Password root MySQL untuk container production (wajib diisi)
DB_ROOT_PASSWORD=change-me-strong-password
# Origin yang diizinkan mengakses API production (pisahkan dengan koma)
CORS_ORIGINS=https://hris.gaselamotor.com