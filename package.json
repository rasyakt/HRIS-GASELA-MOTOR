{
  "name": "gasela-hris",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:clean": "taskkill /F /IM node.exe 2>nul & turbo run dev",
    "kill:node": "taskkill /F /IM node.exe",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "node -e \"const fs=require('fs'); ['.turbo/cache', 'apps/web/.next', 'apps/backend/dist', 'apps/mobile/.expo'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}}); console.log('Semua cache & build artifacts berhasil dibersihkan!')\"",
    "clean:cache": "node -e \"const fs=require('fs'); ['.turbo/cache', 'apps/web/.next/cache', 'apps/mobile/.expo'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}}); console.log('Cache berhasil dibersihkan!')\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,prisma,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "prisma": "^6.19.3",
    "turbo": "^2.3.3"
  }
}